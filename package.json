{
  "name": "traty-sani",
  "productName": "Траты Сани",
  "version": "1.0.5",
  "description": "Траты Сани: учёт расходов, внесений, остатка и отчёты за период",
  "main": "dist/main/main.js",
  "author": "Траты Сани",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:template-db": "electron scripts/build-template-db.js",
    "prebuild:win": "npm run build && npm run build:template-db",
    "build:win": "electron-builder --win --x64",
    "build:portable": "npm run build && npm run build:template-db && electron-builder --win portable --x64",
    "prebuild:mac": "npm run build && npm run build:template-db",
    "build:mac": "electron-builder --mac --arm64",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.2.3",
    "electron-builder": "^24.13.3",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.sani.traty",
    "productName": "Траты Сани",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/template",
        "to": "template",
        "filter": [
          "**/*.db"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ],
      "category": "public.app-category.finance",
      "darkModeSupport": true,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "Траты Сани ${version}",
      "artifactName": "Traty-Sani-${version}-arm64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Траты Сани"
    }
  }
}